# KainBain environment template.
# GENERATED — do not hand-edit. Regenerate with: node scripts/generate-env-example.mjs
# Copy to .env (or export from your shell / systemd unit) and adjust.
# Note: the API does not auto-load a .env file; in dev run
# `node --env-file=.env api/index.js`, in production provide variables
# via the shell or systemd. Unset values fall back to the defaults below.

# --- Server & Network ---
# API listen port (dedicated port; override with PORT).
# Type: int 1-65535.
PORT=3100
# API listen address (0.0.0.0 serves LAN + Tailscale; use 127.0.0.1 to lock down to loopback).
HOST=0.0.0.0
# Origin advertised to integrating agents (GET /agent); production serves https://kainbain.home behind nginx.
# Type: url.
PUBLIC_KB_URL=http://localhost:3100
# Extra browser origins allowed to call the API, comma-separated exact matches (only loopback and origin-less clients are always allowed; no implicit .home, LAN, or tailnet allowances).
# Type: csv.
# CORS_ALLOWED_ORIGINS=
# Runtime mode (test enables CORS bypass + mock harnesses; production is the deployed API).
# Type: one of development | test | production.
NODE_ENV=development
# Node HTTP requestTimeout for the API server in ms; 0 (default) disables it so long chat turns are never killed with a bare 408. Set an explicit positive value only above any opt-in chat ceiling.
# Type: int >= 0.
KAINBAIN_SERVER_REQUEST_TIMEOUT_MS=0
# Operator join secret Runners present at POST /runners/register (D4). Empty (default) disables registration; approved Runners get per-Runner credentials. Redacted in the config-spec endpoint.
# Secret: never commit a real value; redacted in GET /status/config.
# KAINBAIN_RUNNER_JOIN_TOKEN=
# VAPID contact subject (mailto: or URL) identifying the push sender to browser push services.
VAPID_SUBJECT=mailto:admin@kainbain.local

# --- Storage & Paths ---
# Root directory holding one folder per project (tasks, branches, assets).
# Type: path.
PROJECTS_ROOT=/home/server/projects
# Centralised notes space root for project-linked notes (any markdown notes store).
# Type: path.
NOTES_SPACE_ROOT=/home/server/apps/notes/silverbullet/space/Projects/Personal
# Extra project roots scanned alongside PROJECTS_ROOT (OS path-list separated, e.g. colon-separated on POSIX). Projects must be direct children of a root, or registered explicitly.
# Type: pathlist.
# PROJECTS_ROOTS=
# Engine-global registry of extra project roots and adopted project directories outside every root.
# Default: ~/.kainbain/projects.json.
# KAINBAIN_PROJECTS_REGISTRY_FILE=
# Seed sample projects (Project A-D) on boot when missing. Off by default: fresh machines boot with an empty board instead of junk projects.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_SEED_SAMPLE_PROJECTS=false
# Pi agent directory (session + extension state for the pi harness).
# Default: ~/.pi/agent.
# PI_AGENT_DIR=
# Built frontend directory served from the same origin as the API (the deploy script points this at the production build).
# Default: <repo>/frontend/dist.
# KAINBAIN_DIST=
# Markdown docs directory rendered by the in-app Docs tab (GET /docs).
# Default: <repo>/site-docs.
# KAINBAIN_SITE_DOCS=
# Global stage-skills library directory (each <name>/SKILL.md + optional KB_config.json).
# Default: <repo>/skills.
# KAINBAIN_SKILLS_DIR=

# --- Harnesses & Models ---
# Default AI model used for new projects / stages when none is set.
KAINBAIN_DEFAULT_MODEL=deepseek-v4-flash:0731-cloud
# Default project accent color (hex).
KAINBAIN_DEFAULT_ACCENT_COLOR=#7bdb85
# Agent harness used when a project does not select one ("pi"). Unknown names surface the registry warning and fall back to pi.
KAINBAIN_DEFAULT_HARNESS=pi
# The agy CLI binary (name on PATH or absolute path) the antigravity harness spawns per stage.
KAINBAIN_AGY_BIN=agy
# agy --print-timeout duration (the CLI response ceiling, e.g. "10m"); the harness also derives its engine-side watchdog from it.
# Type: duration.
KAINBAIN_AGY_PRINT_TIMEOUT=10m
# Watchdog for the `agy models` discovery spawn; a hung CLI degrades to a warn + empty picker instead of pinning model selection. Raise it on heavily loaded hosts where a slow CLI start is misread as a hang.
# Type: duration.
KAINBAIN_AGY_MODELS_TIMEOUT_MS=15s
# Pass --sandbox to agy runs (operator default OFF: unrestricted runs).
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_AGY_SANDBOX=false
# Pass --dangerously-skip-permissions to agy runs (operator default ON: auto-approved tools).
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_AGY_SKIP_PERMISSIONS=true
# Optional comma-separated action(target) allow rules for agy tools (validated but not yet applied — see the antigravity harness README).
# KAINBAIN_AGY_ALLOW=
# Antigravity session transport: on (two-way ACP session), off (legacy per-turn exec), auto (ACP only when KAINBAIN_AGY_ACP_BIN is set).
# Type: one of auto | on | off.
KAINBAIN_AGY_ACP=auto
# Standalone Antigravity ACP agent binary (engages the ACP session path; blank = `agy acp` subcommand when mode is on).
# KAINBAIN_AGY_ACP_BIN=
# Codex CLI binary the codex harness resolves (PATH name or absolute path; ~/.local/bin is probed). The harness is a theoretical shim on devices without the binary: it refuses with a setup hint and never spawns.
KAINBAIN_CODEX_BIN=codex
# Codex auto-approve by default (no approval UI exists yet); 0 restores per-action approvals once the live transport lands.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CODEX_YOLO=true
# Muse Code CLI binary the muse harness spawns (pin a versioned binary to opt out of the launcher auto-update).
KAINBAIN_MUSE_BIN=muse
# Muse --approval-mode (never keeps approvals off while the sandbox stays ON, unlike --yolo).
# Type: one of never | on-request | untrusted.
KAINBAIN_MUSE_APPROVAL_MODE=never
# Muse --yolo by default (no approval UI exists yet); 0 restores sandbox-on.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_MUSE_YOLO=true
# Muse --trust-workspace (loads project skills/rules).
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_MUSE_TRUST_WORKSPACE=false
# Muse --no-session-log (privacy vs. resume/trace trade-off).
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_MUSE_NO_SESSION_LOG=false
# Engine-side watchdog ceiling for one muse run (defaults to the agent-stage timeout).
# Default: value of KAINBAIN_AGENT_TIMEOUT_MS (unset to follow it).
# KAINBAIN_MUSE_TIMEOUT_MS=
# Extra validated argv for muse runs (e.g. --max-model-steps 200); harness-owned flags are rejected here.
# KAINBAIN_MUSE_ARGS=
# Muse session transport: on (two-way MSP session over `muse serve`), off (legacy per-turn exec — the documented rollback), auto (MSP when the resolved muse binary advertises the serve subcommand, or when KAINBAIN_MUSE_MSP_BIN is set).
# Type: one of auto | on | off.
KAINBAIN_MUSE_MSP=auto
# Standalone muse serve binary override (blank = the resolved KAINBAIN_MUSE_BIN; setting it engages the MSP transport).
# KAINBAIN_MUSE_MSP_BIN=
# Handshake ceiling for the muse serve session start (the per-turn watchdog stays engine-side, as with the exec transport).
# Type: int >= 0.
KAINBAIN_MUSE_MSP_START_TIMEOUT_MS=30000
# Idle TTL before an unused per-project muse serve host is disposed (bounds the host's memory footprint).
# Type: int >= 0.
KAINBAIN_MUSE_MSP_HOST_IDLE_TTL_MS=300000
# Grace between the muse serve watchdog's turn/interrupt and the force-settle of a wedged turn; the host is evicted from the pool when it elapses.
# Type: int >= 0.
KAINBAIN_MUSE_MSP_TURN_SETTLE_GRACE_MS=30000
# Extra validated argv for the muse serve host (e.g. --contributor-mode off); harness-owned pins are rejected here.
# KAINBAIN_MUSE_MSP_ARGS=
# Mistral Vibe CLI binary the vibe harness spawns (PATH name or absolute path; ~/.local/bin is probed).
KAINBAIN_VIBE_BIN=vibe
# Vibe CLI implementation the harness targets. 'python' (recommended) forces the classic CLI whose flag contract the harness uses (--output-dir/--time-limit/--prompt-file, export.json); 'rust' opts into the Rust TUI; 'auto' leaves VIBE_CLI unset and follows the upstream rollout. On vibe >= 3.0 the pin is ignored (the launcher always runs vibe-rs), so leave 'auto' for new installs; the setting is retained so 2.x installs keep working.
# Type: one of python | rust | auto.
KAINBAIN_VIBE_CLI=python
# Vibe --auto-approve by default (no approval UI exists yet); 0 restores per-agent approvals.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_VIBE_AUTO_APPROVE=true
# Vibe --agent profile (builtin: ask, plan, accept-edits, smart-approve, auto-approve, or custom from ~/.vibe/agents/); empty follows the default_agent config.
# KAINBAIN_VIBE_AGENT=
# Vibe --time-limit per run in seconds (unset: the engine watchdog still applies).
# Type: int >= 1.
# KAINBAIN_VIBE_TIME_LIMIT=
# Vibe --trust for headless runs (skips the trust prompt for this invocation only; never persisted).
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_VIBE_TRUST=true
# Vibe --enabled-tools filter (comma-separated exact names, globs, or re: regex; empty disables no filter).
# Type: csv.
# KAINBAIN_VIBE_ENABLED_TOOLS=
# Vibe --disabled-tools filter, applied after the enabled filter (same syntax).
# Type: csv.
# KAINBAIN_VIBE_DISABLED_TOOLS=
# Engine-side watchdog ceiling for one vibe run (defaults to the agent-stage timeout).
# Default: value of KAINBAIN_AGENT_TIMEOUT_MS (unset to follow it).
# KAINBAIN_VIBE_TIMEOUT_MS=
# Extra validated argv for vibe runs (e.g. --smart-approve); harness-owned flags are rejected here.
# KAINBAIN_VIBE_ARGS=
# Vibe session transport: on (two-way ACP session over the standalone vibe-acp agent), off (legacy per-turn exec), auto (ACP when the vibe-acp entrypoint resolves — an explicit KAINBAIN_VIBE_ACP_BIN, or the vibe-acp sibling of the resolved vibe binary).
# Type: one of auto | on | off.
KAINBAIN_VIBE_ACP=auto
# Standalone vibe ACP agent binary override (blank = vibe-acp sibling of the resolved KAINBAIN_VIBE_BIN, then bare vibe-acp on PATH).
# KAINBAIN_VIBE_ACP_BIN=
# Handshake ceiling for the vibe ACP session start (the per-turn watchdog stays engine-side, as with the exec transport).
# Type: int >= 0.
KAINBAIN_VIBE_ACP_START_TIMEOUT_MS=30000
# Fail fast (instead of warn-and-continue on the session default) when a stage targets a model without valid credentials.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_STRICT_MODEL_RUNNABLE=false
# Fail fast (instead of warn-and-continue) when the requested model cannot resolve and model discovery itself failed.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_STRICT_MODEL_DISCOVERY=false
# Explicit LiteLLM endpoint override (else litellm.home, else localhost:4000).
# Type: endpoint.
# LITELLM_URL=
# Second LiteLLM endpoint candidate (full URL preferred; bare host[:port] accepted).
# Type: endpoint.
# LITELLM_HOST=
# Explicit Ollama Cloud endpoint override (else ollama.com, else ollama.ai).
# Type: endpoint.
# OLLAMA_CLOUD_URL=
# Connect to this OpenCode server instead of spawning one per project.
# Type: endpoint.
# OPENCODE_URL=
# Bearer password for the OpenCode server (redacted in the config-spec endpoint).
# Type: string.
# Secret: never commit a real value; redacted in GET /status/config.
# OPENCODE_SERVER_PASSWORD=
# opencode CLI binary for availability detection (`~/.opencode/bin` is also searched; OPENCODE_URL skips the binary entirely).
KAINBAIN_OPENCODE_BIN=opencode

# --- Timeouts & Autoloop Budgets ---
# Max wall-clock for one agent stage (30 min).
# Type: int >= 0.
KAINBAIN_AGENT_TIMEOUT_MS=1800000
# Max wall-clock for a CI/script stage (10 min; the canonical `npm run test` gate includes the ~7-min canary E2E suite).
# Type: int >= 0.
KAINBAIN_CI_TIMEOUT_MS=600000
# Max wall-clock for a merge stage (30 min).
# Type: int >= 0.
KAINBAIN_MERGE_TIMEOUT_MS=1800000
# Max silence before an agent stage is marked stalled (10 min; 0 disables).
# Type: int >= 0.
KAINBAIN_AGENT_STALL_TIMEOUT_MS=600000
# Max silence before a CI/script stage is marked stalled (5 min; 0 disables). Secondary guard: a running CI/script stage heartbeats on the ciHeartbeatIntervalMs keep-alive while its child runs, so only a stage whose child (and keep-alive) is truly dead goes silent.
# Type: int >= 0.
KAINBAIN_CI_STALL_TIMEOUT_MS=300000
# Keep-alive tick for a running CI/script stage (30s): the stage heartbeat is refreshed on this interval while the child runs, so a legitimately quiet command (a long test gate, an install, a docker build) is never killed as stalled by silence alone. Must stay below KAINBAIN_CI_STALL_TIMEOUT_MS; 0 disables the keep-alive (emergency lever — the silence watchdog then guards alone).
# Type: int >= 0.
KAINBAIN_CI_HEARTBEAT_INTERVAL_MS=30000
# Max silence before a merge stage is marked stalled (15 min; 0 disables).
# Type: int >= 0.
KAINBAIN_MERGE_STALL_TIMEOUT_MS=900000
# Settle guarantee for one ExecutionQueue entry (15 min; 0 disables). A stage run that neither resolves nor rejects within this budget is force-settled with an EQUEUE_TIMEOUT rejection and routed to the transient-failure ladder, so a single wedged run can never park the scheduler forever. Must stay above the longest stall-silence budget; 0 disables the guarantee (emergency lever — the scheduler wedge watchdog then guards alone).
# Type: int >= 0.
KAINBAIN_QUEUE_ENTRY_TIMEOUT_MS=900000
# Opt-in ceiling for one retrospective chat turn in ms; 0 (default) disables it so the turn runs until the model answers or the caller cancels. Set an explicit positive value to re-impose a ceiling (slow turns then surface as structured 504 JSON).
# Type: int >= 0.
KAINBAIN_CHAT_PROMPT_TIMEOUT_MS=0
# Wall-clock timeout for one stuck-check diagnosis model run.
# Type: int >= 0.
KAINBAIN_STUCK_CHECK_TIMEOUT_MS=120000
# Master switch for automatic failback-and-retry after a failed stage (fix -> re-test -> re-review).
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_AUTO_ITERATION_ENABLED=true
# Max automatic failback->re-execute cycles before a task is parked as failed for a human.
# Type: int >= 0.
KAINBAIN_MAX_AUTO_ITERATIONS=8
# Max same-stage retries for transient infra failures (5xx, timeouts) before parking at the stage that actually failed.
# Type: int >= 0.
KAINBAIN_MAX_TRANSIENT_RETRIES=5
# Base delay for Tier-2 transient same-stage retries in ms (linear: base*attempt; exponential: base*2^(attempt-1)). Set 2000/30000/0 with strategy linear to reproduce the legacy timing exactly.
# Type: int >= 0.
KAINBAIN_TRANSIENT_RETRY_BASE_MS=2000
# Ceiling for one Tier-2 transient retry sleep in ms; keeps the scheduler responsive during long gateway flaps.
# Type: int >= 0.
KAINBAIN_TRANSIENT_RETRY_CAP_MS=60000
# Symmetric jitter bound in ms applied to each Tier-2 retry delay (actual = base-delay +/- uniform(0, jitter), clamped to [0, cap]); decorrelates retries against rate-limited providers.
# Type: int >= 0.
KAINBAIN_TRANSIENT_RETRY_JITTER_MS=1000
# Tier-2 backoff shape: exponential (base*2^(attempt-1), capped) or linear (base*attempt, capped — legacy behavior with base 2000/cap 30000/jitter 0).
# Type: one of exponential | linear.
KAINBAIN_TRANSIENT_RETRY_STRATEGY=exponential
# Consecutive tool failures before the agent tool-loop guard aborts the stage (global default; per-stage/per-project tuning reserved for WP9 auto-iteration calibration).
# Type: int >= 1.
KAINBAIN_TOOL_LOOP_STRIKES=3

# --- Health & Observability ---
# Model-discovery cache TTL.
# Type: int >= 0.
KAINBAIN_MODEL_CACHE_TTL_MS=30000
# Health-check aggregate cache TTL.
# Type: int >= 0.
KAINBAIN_HEALTH_CACHE_TTL_MS=15000
# LiteLLM probe timeout.
# Type: int >= 0.
KAINBAIN_HEALTH_LITELLM_TIMEOUT_MS=3000
# Ollama Cloud probe timeout.
# Type: int >= 0.
KAINBAIN_HEALTH_OLLAMA_TIMEOUT_MS=4000
# Per-harness health-probe timeout (a slow probe reports an error check without blocking the aggregate).
# Type: int >= 0.
KAINBAIN_HEALTH_HARNESS_TIMEOUT_MS=4000
# Per-harness model-listing timeout (a slow harness serves an honest empty list instead of stalling the catalogue).
# Type: int >= 0.
KAINBAIN_MODELS_HARNESS_TIMEOUT_MS=8000
# System Settings harness Refresh also re-runs the shared model catalogue past both caches; 0 restores the old harness-only refresh.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_REFRESH_MODELS_ON_HARNESS_REFRESH=true
# Memory % used -> device health error.
# Type: int 0-100.
KAINBAIN_HEALTH_MEM_CRITICAL_PCT=95
# Memory % used -> device health warning.
# Type: int 0-100.
KAINBAIN_HEALTH_MEM_WARN_PCT=85
# Load-per-core -> device health error.
# Type: float >= 0.
KAINBAIN_HEALTH_LOAD_CRITICAL_PER_CORE=4
# Load-per-core -> device health warning.
# Type: float >= 0.
KAINBAIN_HEALTH_LOAD_WARN_PER_CORE=2.5
# Outbound alert webhook endpoint (signed POST per parked failure, checkpoint, trip/reset, rollback, and failback warning). Empty (default) disables outbound alerting entirely.
# Type: url.
# KAINBAIN_ALERT_WEBHOOK_URL=
# HMAC-SHA256 key signing outbound alert bodies (X-KainBain-Signature). Empty sends unsigned; the secret never enters payloads or logs.
# Secret: never commit a real value; redacted in GET /status/config.
# KAINBAIN_ALERT_WEBHOOK_SECRET=
# Total POST attempts per alert delivery before giving up (a dead sink never fails the task).
# Type: int >= 0.
KAINBAIN_ALERT_RETRIES=3
# Base backoff between alert retries in ms (exponential with jitter).
# Type: int >= 0.
KAINBAIN_ALERT_RETRY_BASE_MS=500
# Per-attempt timeout for one alert POST in ms.
# Type: int >= 0.
KAINBAIN_ALERT_TIMEOUT_MS=5000
# Master switch for the global engine circuit breaker (Tier 5 containment). 0 disables every auto-trip sensor and the manual trip gate still works.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CIRCUIT_ENABLED=true
# Durable JSON file holding the engine containment state (tripped/reset reason, source, timestamps, canary). Survives restarts.
# Default: ~/.kainbain/engine/circuit.json.
# KAINBAIN_CIRCUIT_STATE_FILE=
# Trip sensor: N infrastructure failures across distinct tasks inside the sliding window.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CIRCUIT_INFRA_ENABLED=true
# Consecutive infrastructure failures (across any tasks, inside the window) before the engine trips. Counted per failure, not per distinct task: the single-active scheduler retries the same stage in place, so a provider outage surfaces as a streak on one task.
# Type: int >= 1.
KAINBAIN_CIRCUIT_INFRA_FAILURE_THRESHOLD=3
# Sliding window (ms) for the infrastructure-failure trip sensor; failures older than this fall out.
# Type: int >= 0.
KAINBAIN_CIRCUIT_INFRA_FAILURE_WINDOW_MS=600000
# Trip sensor: sustained provider authentication failures (HTTP 401/403, invalid api key) across distinct tasks.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CIRCUIT_AUTH_ENABLED=true
# Consecutive provider-authentication failures (401/403/invalid key) before the engine trips; auth never self-heals by retrying.
# Type: int >= 1.
KAINBAIN_CIRCUIT_AUTH_FAILURE_THRESHOLD=3
# Sliding window (ms) for the provider-authentication trip sensor.
# Type: int >= 0.
KAINBAIN_CIRCUIT_AUTH_FAILURE_WINDOW_MS=600000
# Trip sensor: host disk free space below the configured floor.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CIRCUIT_DISK_ENABLED=true
# Free-disk floor in bytes; a confirmed breach trips the engine before any further dispatch.
# Type: int >= 0.
KAINBAIN_CIRCUIT_DISK_FREE_FLOOR_BYTES=1073741824
# Path whose filesystem is probed for free space by the disk trip sensor.
# Default: ~ (home directory).
# KAINBAIN_CIRCUIT_DISK_PROBE_PATH=
# Trip sensor: memory-critical percentage sustained over M scheduler ticks.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CIRCUIT_MEM_ENABLED=true
# Consecutive scheduler ticks memory must stay at/above KAINBAIN_HEALTH_MEM_CRITICAL_PCT before the engine trips (debounces GC spikes).
# Type: int >= 1.
KAINBAIN_CIRCUIT_MEM_SUSTAINED_TICKS=3
# Half-open canary probe: while tripped, admit exactly one test task after the cooldown before lifting containment fully.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CIRCUIT_PROBE_ENABLED=true
# Delay before the first half-open canary is admitted after a trip, and the base for exponential re-trip backoff.
# Type: int >= 0.
KAINBAIN_CIRCUIT_PROBE_COOLDOWN_MS=60000
# Upper bound for the canary re-trip cooldown backoff (each failed canary doubles the wait, capped here).
# Type: int >= 0.
KAINBAIN_CIRCUIT_PROBE_BACKOFF_CAP_MS=600000
# Whether a non-infrastructure (logical) canary failure also re-trips conservatively. 0 lets a logical failure lift the trip instead.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_CIRCUIT_PROBE_FAILURE_RETRIPS=true

# --- Skills & Prompts ---
# Cap on injected skill text (chars) in one curated stage prompt.
# Type: int >= 0.
KAINBAIN_STAGE_SKILLS_MAX_CHARS=16000
# Stage-skills directory scan cache TTL.
# Type: int >= 0.
KAINBAIN_SKILLS_CACHE_TTL_MS=5000
# Max bytes for one skill import upload (.md/.zip); oversized uploads are rejected with 413.
# Type: int >= 0.
KAINBAIN_SKILL_IMPORT_MAX_BYTES=1048576
# Max file entries accepted inside an import zip (zip-bomb guard).
# Type: int >= 0.
KAINBAIN_SKILL_IMPORT_ZIP_MAX_ENTRIES=64
# Max total uncompressed bytes of an import zip (zip-bomb guard).
# Type: int >= 0.
KAINBAIN_SKILL_IMPORT_ZIP_MAX_BYTES=524288
# Cap on injected skill text (chars) in one chat turn.
# Type: int >= 0.
KAINBAIN_CHAT_SKILLS_MAX_CHARS=6000

# --- Tasks & Review ---
# Max bytes of one stage's captured streamed output kept in memory while it runs (in-flight buffers, not stored task logs).
# Type: int >= 0.
KAINBAIN_PROCESS_LOG_MAX_BYTES=32000
# Max structured log entries kept on a task (oldest evicted under a marker; the single bound on task log storage).
# Type: int >= 0.
KAINBAIN_LOG_ENTRIES_MAX_COUNT=500
# Max usage-telemetry records kept per stage run (reserved budget inside logEntriesMaxCount).
# Type: int >= 0.
KAINBAIN_TELEMETRY_MAX_COUNT=100
# Max unmapped-wire evidence records kept per stage run (overflow evicted under a raw-lane marker).
# Type: int >= 0.
KAINBAIN_LOG_RAW_MAX_COUNT=50
# Max bytes of one raw evidence source payload (scrubbed + truncated).
# Type: int >= 0.
KAINBAIN_LOG_RAW_MAX_BYTES=8192
# Max bytes for one uploaded task image (10 MB); oversized uploads are rejected with 413.
# Type: int >= 0.
KAINBAIN_TASK_IMAGE_MAX_BYTES=10485760
# Max image assets stored per task folder.
# Type: int >= 0.
KAINBAIN_TASK_IMAGE_MAX_PER_TASK=20
# Max image file references injected into one curated stage prompt (overflow is summarized).
# Type: int >= 0.
KAINBAIN_TASK_IMAGE_MAX_PROMPT_REFS=10
# Max total bytes of image data attached to one vision-capable dispatch.
# Type: int >= 0.
KAINBAIN_TASK_IMAGE_MAX_ATTACH_BYTES=10485760
# Max chars of per-feed task logs sent to the stuck-check diagnosis model (tail kept).
# Type: int >= 0.
KAINBAIN_STUCK_CHECK_MAX_LOG_CHARS=20000
# Max bytes for a single file diff in the review view.
# Type: int >= 0.
KAINBAIN_REVIEW_DIFF_MAX_BYTES=262144
# Max characters for a review comment body.
# Type: int >= 0.
KAINBAIN_REVIEW_MAX_COMMENT_CHARS=4000
# Master switch for Web Push notifications (queue-empty and human-intervention alerts); per-trigger toggles live in General App Settings.
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_PUSH_NOTIFICATIONS_ENABLED=true

# --- Sessions & Workflows ---
# Autonomous scheduler tick interval.
# Type: int >= 0.
KAINBAIN_SCHEDULER_INTERVAL_MS=3000
# Disable the autonomous scheduler loop (for test harnesses or scratch instances).
# Type: 1/true/yes/on or 0/false/no/off.
KAINBAIN_DISABLE_SCHEDULER=false
# Idle TTL before a session with no open sockets is disposed.
# Type: int >= 0.
KAINBAIN_SESSION_TTL_MS=1800000
# Session cleanup sweep interval.
# Type: int >= 0.
KAINBAIN_SESSION_CLEANUP_MS=60000
# Workflow-run TTL (entries older than this are swept so the registry does not grow unboundedly).
# Type: int >= 0.
KAINBAIN_WORKFLOW_RUN_TTL_MS=86400000
# Workflow-run TTL sweep interval.
# Type: int >= 0.
KAINBAIN_WORKFLOW_SWEEP_MS=3600000
# Opt this implementation into KainBain's cross-restart self-deploy continuity (api/continuity/). Set to exactly 1 to enable; unset or any other value leaves the generic pipeline free of deploy-specific behaviour.
# KAINBAIN_SELF_DEPLOY_CONTINUITY=

# --- Deprecated aliases (do not use in new setups) ---
# These still work but warn at boot; prefer the canonical names above.
# AGENT_TIMEOUT_MS is deprecated, use KAINBAIN_AGENT_TIMEOUT_MS.
# AGENT_TIMEOUT_MS=
# CI_TIMEOUT_MS is deprecated, use KAINBAIN_CI_TIMEOUT_MS.
# CI_TIMEOUT_MS=
# MERGE_TIMEOUT_MS is deprecated, use KAINBAIN_MERGE_TIMEOUT_MS.
# MERGE_TIMEOUT_MS=
# AUTO_ITERATION_ENABLED is deprecated, use KAINBAIN_AUTO_ITERATION_ENABLED.
# AUTO_ITERATION_ENABLED=
# MAX_AUTO_ITERATIONS is deprecated, use KAINBAIN_MAX_AUTO_ITERATIONS.
# MAX_AUTO_ITERATIONS=
# MAX_TRANSIENT_RETRIES is deprecated, use KAINBAIN_MAX_TRANSIENT_RETRIES.
# MAX_TRANSIENT_RETRIES=
# SCHEDULER_DISABLED is deprecated, use KAINBAIN_DISABLE_SCHEDULER.
# SCHEDULER_DISABLED=
# DISABLE_SCHEDULER is deprecated, use KAINBAIN_DISABLE_SCHEDULER.
# DISABLE_SCHEDULER=
