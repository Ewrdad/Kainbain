# KainBain production config — copy to .env in the install folder and edit.
# Secrets only below; container paths are fixed in docker-compose.yml.
KAINBAIN_IMAGE_TAG=latest
KAINBAIN_BUILD_NUMBER=0
KAINBAIN_PORT=3100
# Existing folders to keep (absolute host paths preserve continuity):
KAINBAIN_PROJECTS_HOST=./projects
KAINBAIN_STATE_HOST=./data
KAINBAIN_NOTES_HOST=./notes
NODE_ENV=production
PUBLIC_KB_URL=http://localhost:3100
CORS_ALLOWED_ORIGINS=https://kainbain.home
KAINBAIN_RUNNER_EXECUTION_ONLY=1
KAINBAIN_SELF_DEPLOY_CONTINUITY=1
KAINBAIN_DEFAULT_HARNESS=pi
# KAINBAIN_RUNNER_JOIN_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
