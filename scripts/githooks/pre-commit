#!/bin/sh
# Binary-guard pre-commit hook: fail fast when a staged binary (PNG proof,
# image asset, zip/tgz bundle) has corrupt magic bytes — usually from a
# text-tool rewrite (magic `ef bf bd` instead of e.g. PNG `89 50 4e 47`).
# Commit-time backstop; the pre-handoff preflight is `npm run check:binaries`
# and the `npm test` "Binary Guard" branch. Documented safe path:
# docs/tasks/_PROOF_RULE.md (capture via
# `node scripts/capture-screenshot.mjs --out <path>`, never text tools).
#
# Installed per checkout by `npm run setup` / `npm run hooks:install`
# (scripts/install-git-hooks.mjs sets core.hooksPath to scripts/githooks;
# linked worktrees share the repo's common config, so engine-created kb-*
# worktrees inherit the hook automatically).
# Bypass only to land an intentional baseline entry (never for new damage):
#   git commit --no-verify
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
if [ -z "$root" ]; then
	echo "pre-commit: cannot resolve the repository root, so the binary guard cannot run — refusing to commit (fail closed)." >&2
	echo "pre-commit: run 'npm run hooks:install' once per checkout; use 'git commit --no-verify' only for an intentional baseline entry." >&2
	exit 1
fi

if ! command -v node >/dev/null 2>&1; then
	echo "pre-commit: node is not on PATH, so the binary guard cannot run — refusing to commit (fail closed)." >&2
	exit 1
fi

node "$root/scripts/check-binary-guard.mjs" --staged --root "$root"
status=$?
if [ "$status" -ne 0 ]; then
	echo "pre-commit: binary guard rejected staged binaries (see above for the file and the safe remedy)." >&2
fi
exit "$status"
