# Example env for local dev: copy to `.env` and adjust for your host.
# Values below are localhost dev defaults (API on :3100).
#
# KainBain API connection.
#
# This host runs Forgejo on :3000 (which the pi harness service occupies), so
# the KainBain API runs on its own dedicated port :3100. The frontend must be
# told where the API lives — Vite inlines VITE_* vars at dev-server start and
# at `vite build`, so this one file covers both local dev and the production
# build served by `deploy.sh`.
#
# If you deploy KainBain elsewhere, point these at your API origin instead.
VITE_API_BASE=http://localhost:3100
VITE_WS_URL=ws://localhost:3100

# External notes viewer (SilverBullet) base URL for "open report" deep links.
# Optional: when unset, those links degrade to the in-app file browser
# (#/explorer) so they never hang on an unreachable host. Supports
# ${PROJECT}/${PATH} placeholders; otherwise the
# /Projects/Personal/<project>/<subpath> shape is appended.
# Homelab example: VITE_NOTES_VIEWER_URL=http://notes.local
VITE_NOTES_VIEWER_URL=

# Frontend<->backend lockstep stamp (MigrationPlan Phase 1 WP-1.1, D7).
# Baked into the bundle at `vite build`; the UI compares it against
# /status build.commit and shows an explicit banner on mismatch.
# Compose passes KAINBAIN_BUILD_REF through automatically — set it from the
# same commit as the backend image:
#   KAINBAIN_BUILD_REF=$(git rev-parse --short HEAD) docker compose up --build
# Empty (or "dev"/"unknown") means unstamped: the banner stays hidden.
# VITE_BUILD_REF=dev

# System Settings: also refresh shared model catalogue when probing a harness.
# Optional build-time fallback when running offline or without an API server
# (the backend KAINBAIN_REFRESH_MODELS_ON_HARNESS_REFRESH config is authoritative).
# Set to 0/false/off to disable.
# VITE_ENABLE_SYSTEM_SETTINGS_MODEL_REFRESH=1
