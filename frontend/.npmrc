# Mirror of the root .npmrc (npm reads this flag from <install-dir>/.npmrc
# only — the root .npmrc does NOT apply to installs run in this directory).
# KEPT: eslint-plugin-jsx-a11y (6.10.2, peers eslint <=9) does not accept the
# installed ESLint 10 — keep until the plugin ships ESLint 10 peer support.
# See DEPRECATIONS.md spike 3. Keep in sync with the root .npmrc.
legacy-peer-deps=true
