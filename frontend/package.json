{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:react && node scripts/check-no-deprecations.js",
    "check:react": "node scripts/check-react-imports.js",
    "preview": "vite preview",
    "test": "npm run check:duplicate-identifiers && vitest run",
    "lint": "eslint . --cache --cache-strategy content",
    "format": "prettier --write .",
    "check:duplicate-identifiers": "node ../scripts/check-duplicate-settings.mjs"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "postcss": "^8.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
