# KEPT (retested 2026-10-05): strict peer resolution still fails because the
# latest eslint-plugin-react (7.37.5, peers eslint <=9.7) and
# eslint-plugin-jsx-a11y (6.10.2, peers eslint <=9) do not accept the installed
# ESLint 10 — no newer plugin exists, and downgrading ESLint would move the
# wrong way. Keep until the plugins ship ESLint 10 peer support.
# See DEPRECATIONS.md spike 3. Every install (`npm run setup`, contributor
# installs, Dockerfile `npm ci`) must resolve the same way as the lockfiles.
# npm reads this flag from <install-dir>/.npmrc only, so api/.npmrc,
# frontend/.npmrc, and canary-e2e/.npmrc mirror this file (the Dockerfile
# COPYs it into the image build the same way). Keep them in sync.
legacy-peer-deps=true
